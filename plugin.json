{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "print3d",
  "version": "4.3.0",
  "description": "Idea, photo or shop listing to a sliced project for a Bambu Lab X2D or P2S (Bambu Studio) or an Elegoo Centauri Carbon or Centauri Carbon 2 (ElegooSlicer), with a 3D view of the part to rotate. Needs Blender 4.2+ (the install is refused without it) and the printer's slicer. Runs on Windows, macOS and Linux.",
  "author": { "name": "mfranzon" },
  "homepage": "https://github.com/mfranzon/print3d",
  "repository": "https://github.com/mfranzon/print3d",
  "license": "MIT",
  "keywords": ["3d-printing", "blender", "bambu", "cad"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "print3d": {
          "trust": "untrusted",
          "app": {
            "win32": {
              "presence": "executable",
              "location": [
                { "kind": "uninstall_registry", "display_name_prefix": "Blender", "file": "blender.exe" },
                "%ProgramFiles%/Blender Foundation/Blender */blender.exe"
              ],
              "version": { "kind": "pe_resource" }
            },
            "darwin": {
              "presence": "bundle",
              "location": [
                { "kind": "app_bundle", "name": "Blender.app" },
                "~/Library/Application Support/Steam/steamapps/common/Blender/Blender.app"
              ],
              "version": { "kind": "plist" }
            },
            "linux": {
              "presence": "executable",
              "location": [
                { "kind": "command", "name": "blender" },
                { "kind": "flatpak", "app_id": "org.blender.Blender" },
                { "kind": "snap", "name": "blender" },
                "~/.steam/steam/steamapps/common/Blender/blender",
                "~/.local/share/Steam/steamapps/common/Blender/blender",
                "~/blender-*/blender",
                "/opt/blender*/blender"
              ]
            }
          },
          "requires": { "app": true, "min_version": "4.2" }
        }
      }
    }
  }
}
